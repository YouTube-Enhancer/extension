{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"arrowParens": "always",
	"endOfLine": "lf",
	"printWidth": 150,
	"semi": true,
	"singleQuote": false,
	"tabWidth": 2,
	"trailingComma": "none",
	"useTabs": true,
	"ignorePatterns": [
		"node_modules",
		"dist",
		".all-contributorsrc",
		"CHANGELOG.md",
		"README.md",
		"package.json",
		"package-lock.json",
		"yarn.lock",
		"public/locales/en-US.json.d.ts"
	]
}
