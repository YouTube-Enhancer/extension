import { metadata } from "@/src/features/__FEATURE_ID__/index.metadata";
import { resolveNonTargetPage, resolvePageTypes } from "@/src/utils/_tests/utils";
import {
	test,
	verifyLoadsAtDefaults,
	verifyNonTargetSilence,
	verifyShippedDefaults
} from "@/tests/harness";

const testPages = resolvePageTypes(metadata.dependencies?.includePages);
const nonTargetPage = resolveNonTargetPage(metadata.dependencies);

/**
 * Bare-minimum contract, generated for every registered feature so a spec can never be
 * missing. The bodies come from the shared lifecycle battery (tests/harness/lifecycle.ts),
 * so a generated spec inherits the one implementation of each sequence: the
 * shipped-defaults check, a clean load per page (login-only pages wait for a signed-in
 * session and live waits for a stream rather than failing when there is none; the harness
 * asserts no extension errors at teardown), and the non-target silence check. What it
 * deliberately does not generate: the feature's own effect on each page in `testPages`
 * (the body class, the button, the element it hides, the config it writes) plus anything
 * feature-specific - add those on top, and add verifyReloadPersistence /
 * verifyNavigationPersistence / verifyReEnableCycle cases once the spec has an observable.
 */
test.describe("__FEATURE_ID__", () => {
	test("is disabled in the shipped defaults", async () => {
		await verifyShippedDefaults("__FEATURE_ID__");
	});

	for (const pageType of testPages) {
		test(`loads ${pageType} cleanly at its defaults`, async ({ page }) => {
			await verifyLoadsAtDefaults(page, pageType);
		});
	}

	test("raises no errors on a non-target page", async ({ page }) => {
		test.skip(nonTargetPage === undefined, "every page type belongs to this feature");
		if (!nonTargetPage) return;
		// The page gate must keep the feature's listeners away from a page it was not built
		// for; a leaked onEnable arms them anyway and misfires against elements that do not
		// exist, which shows up as a page error somewhere else in the suite.
		await verifyNonTargetSilence(page, nonTargetPage, "__FEATURE_ID__");
	});
});
